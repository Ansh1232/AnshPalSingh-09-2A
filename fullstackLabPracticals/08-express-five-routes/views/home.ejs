<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Express Notes</title>
<style>
body{font-family:Arial;background:#fdf2f8;max-width:600px;margin:40px auto;padding:0 16px;color:#1f2937}
.notes-ul li{background:white;padding:10px 14px;margin:6px 0;border-left:4px solid #db2777;border-radius:4px;list-style:none}
.add-note input{padding:9px;width:70%}
.add-note button{padding:9px 14px;background:#db2777;color:white;border:0;border-radius:5px;cursor:pointer}
.top-links{margin-top:20px}.top-links a{color:#9d174d}
</style></head><body>
<h1>Notes</h1><ul class="notes-ul"><% notes.forEach(note => { %><li><%= note %></li><% }) %></ul>
<form class="add-note" method="POST" action="/notes"><input name="note" required><button>Add note</button></form>
<nav class="top-links"><a href="/about">About</a> | <a href="/contact">Contact</a> | <a href="/api/notes">Notes API</a></nav>
</body></html>
